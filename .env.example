# Copy to .env (never committed) or export these variables in CI.
# Environment file under config/ to load (default: local).
TEST_ENV=local
# Overrides the base_url of the environment file.
BASE_URL=
# Folder served locally when no BASE_URL is set.
SERVE_DIR=
# Default wait timeout in milliseconds.
TIMEOUT_MS=
# Credentials of the test user (secrets: set them outside the repository).
TEST_USER_NAME=
TEST_USER_PASSWORD=
